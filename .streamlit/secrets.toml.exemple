# Copie ce fichier en "secrets.toml" (même dossier), puis adapte si besoin.
# secrets.toml ne doit jamais aller sur GitHub (il est dans .gitignore).
[sql]
serveur = "localhost"            # instance par défaut ABDELJAOUAD (pas localhost\DEV, qui est SSAS)
pilote = ""                      # vide = détection automatique (ODBC Driver 18, puis 17)
base_dwh = "TuniShop_DWH"
base_analytics = "TuniShop_ANALYTICS"
